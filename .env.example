# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stack grátis para começar: Gemini (sem cartão), Supabase Free, Vercel Hobby e Mercado Pago em demo.

# --- IA (free tier do Google Gemini: sem cartão) ---
# Gere a chave em https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_WRITER_MODEL=gemini-flash-lite-latest
AI_JUDGE_MODEL=gemini-3.1-flash-lite
# Modelos tentados na ordem se houver 429/503 (separados por vírgula)
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Nota mínima do jurado para aprovar sem reescrita (0-100)
AI_REVIEW_THRESHOLD=80

# Alternativa 100% gratuita via OpenRouter (chave em https://openrouter.ai/keys):
# AI_API_KEY=<chave OpenRouter>
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_WRITER_MODEL=openrouter/free
# AI_JUDGE_MODEL=openrouter/free

# Quando quiser pagar por modelo melhor:
# AI_API_KEY=<chave OpenAI>
# AI_BASE_URL=https://api.openai.com/v1
# AI_WRITER_MODEL=gpt-4.1-mini
# AI_JUDGE_MODEL=gpt-4.1

# Legado: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL e OPENAI_JUDGE_MODEL continuam funcionando.

# --- Supabase (plano Free; use um PROJETO NOVO, as tabelas não coexistem com evidence-reps) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamentos ---
# demo = sem cobrança (ideal no início); live = Mercado Pago real
PAYMENT_MODE=demo
# Public key (APP_USR-...): apenas referência; o checkout usa init_point, sem SDK no cliente
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Segredo de assinatura do webhook (x-signature)
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Geração automática (job de segunda) ---
CRON_SECRET=
# Coleta de tendências via Google News RSS (não exige chave)
NEWS_LOCALE=pt-BR
NEWS_REGION=BR
NEWS_LANGUAGE=pt-419
